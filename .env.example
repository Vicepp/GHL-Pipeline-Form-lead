# Pheenyx Capital - Pipeline Workflow
# =====================================================================
# TEMPLATE ONLY - this file is committed and must never contain real
# values. Copy it to .env.local (which is gitignored) and fill that in:
#
#     cp .env.example .env.local
#
# WHO NEEDS THESE
# ---------------
# Only the serverless endpoint api/ghl-inbound.js - the part that
# receives GoHighLevel webhooks. The website itself needs none of them:
# its Firebase web config lives in assets/js/config.js and is public by
# design (access is enforced by firestore.rules + Auth).
#
# WHERE THEY ACTUALLY GO IN PRODUCTION
# ------------------------------------
# Vercel dashboard -> your project -> Settings -> Environment Variables.
# Add all four there, then redeploy - env vars only take effect on a new
# deployment. This .env.local file is ONLY for running the API on your
# own machine with `vercel dev`.
#
# After adding them in Vercel you can pull them down with:
#     vercel env pull .env.local
# =====================================================================


# Any long random string you invent (30+ characters). GoHighLevel sends
# this back with every webhook - it is what stops strangers posting fake
# leads at the endpoint. Put the same value in the GHL webhook action,
# either as ?key=... on the URL or as an x-inbound-key header.
INBOUND_SECRET=

# The next three all come out of the service account JSON you download
# from: Firebase console -> Project settings -> Service accounts
#       -> Generate new private key
#
# That file is a REAL secret - it grants full database access. Keep it at
# tools/service-account.json (gitignored) and never paste it anywhere.

# "project_id" from that JSON
FIREBASE_PROJECT_ID=ghl-phc-pipeline

# "client_email" from that JSON
# looks like: firebase-adminsdk-xxxxx@ghl-phc-pipeline.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=

# "private_key" from that JSON - the whole block, including the
# -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY----- lines.
# In a .env file it must be on ONE line wrapped in double quotes, with
# the line breaks written as \n (that is exactly how it appears in the
# JSON, so copy the value straight across, quotes and all).
# In the Vercel dashboard you can paste it with real line breaks instead.
FIREBASE_PRIVATE_KEY=""


# ---------------------------------------------------------------------
# THE PUBLIC FIREBASE WEB CONFIG - reference only, not read by anything.
# The browser gets these from assets/js/config.js; that file is where to
# change them. They are public by design - access is enforced by
# firestore.rules plus Auth, not by keeping these hidden - which is why
# they are committed to the repo. tools/make-env.js copies them into
# .env.local automatically so the two cannot drift apart.
# ---------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
